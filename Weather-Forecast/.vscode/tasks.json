{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "serve-8000-py",
      "type": "shell",
      "command": "py -m http.server 8000 --bind 127.0.0.1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "python",
        "fileLocation": ["absolute"],
        "pattern": {
          "regexp": ".+",
          "file": 1,
          "message": 0
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*http\\.server.*",
          "endsPattern": "Serving HTTP on 127\\.0\\.0\\.1 port 8000.*"
        }
      }
    },
    {
      "label": "serve-8000-python",
      "type": "shell",
      "command": "python -m http.server 8000 --bind 127.0.0.1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": "$tsc-watch"
    }
  ]
}
